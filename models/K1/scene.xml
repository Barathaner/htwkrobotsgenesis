<mujoco model="K1 scene">

  <include file="K1_22dof.xml"/>

  <!-- Frame the free camera nicely on a ~1 m tall robot standing near the origin. -->
  <statistic center="0 0 0.55" extent="1.3"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="130" elevation="-20" offwidth="1920" offheight="1080"/>
    <quality shadowsize="4096"/>
  </visual>

  <worldbody>
    <!-- Chase camera that follows the robot's centre of mass; pick it in the viewer
         with the '[' / ']' keys or Tab, or render from it for videos. -->
    <camera name="track" mode="trackcom" pos="0 -2.6 1.3" xyaxes="1 0 0 0 0.45 1"/>
    <!-- Fixed side camera, handy for a consistent recording angle. -->
    <camera name="side" pos="2.4 -2.4 1.2" xyaxes="0.7 0.7 0 -0.25 0.25 0.93"/>
  </worldbody>
</mujoco>
